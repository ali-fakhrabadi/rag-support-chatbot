# Copy to .env and adjust. Secrets do NOT go here: they live in ./secrets (scripts/init-secrets.sh).

# --- web ---
WEB_BIND=127.0.0.1
WEB_PORT=8080

# --- application ---
RAG_ENVIRONMENT=production
RAG_LOG_LEVEL=INFO
RAG_ENABLE_DOCS=true
# nginx in front of the API sets X-Real-IP; trust it only behind that proxy.
RAG_TRUST_PROXY_HEADERS=true

# --- models ---
# Default: a local Ollama. With the optional compose profile use http://ollama:11434;
# for Ollama on the Docker host use http://host.docker.internal:11434.
RAG_OLLAMA_BASE_URL=http://host.docker.internal:11434
# Optional: a different Ollama for embeddings only (defaults to RAG_OLLAMA_BASE_URL).
# RAG_OLLAMA_EMBEDDING_BASE_URL=http://embeddings-host:11434
RAG_EMBEDDING_PROVIDER=ollama
RAG_EMBEDDING_MODEL=nomic-embed-text
RAG_EMBEDDING_DIM=768
RAG_LLM_PROVIDER=ollama
RAG_LLM_MODEL=llama3.1:8b
RAG_LLM_TIMEOUT_S=300
# RAG_LLM_NUM_THREAD=8

# Optional OpenAI provider. Retrieved document passages and questions are then sent to OpenAI.
# Put the key in secrets/openai_api_key, then:
# RAG_LLM_PROVIDER=openai
# RAG_LLM_MODEL=gpt-4o-mini

# --- retrieval ---
RAG_RETRIEVAL_TOP_K=5
# Calibrated for nomic-embed-text on the dev split (docs/evaluation/evaluation-methodology.md).
RAG_MIN_SIMILARITY=0.54
RAG_CHUNK_SIZE=1200
RAG_CHUNK_OVERLAP=200

# --- limits ---
RAG_MAX_UPLOAD_MB=20
RAG_MAX_PDF_PAGES=300
RAG_RATE_LIMIT_LOGIN_PER_MINUTE=10
RAG_RATE_LIMIT_CHAT_PER_MINUTE=20

# --- build ---
# PIP_INDEX_URL=https://pypi.org/simple
# NPM_REGISTRY=https://registry.npmjs.org/
